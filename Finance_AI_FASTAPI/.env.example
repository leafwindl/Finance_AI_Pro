# LangGraph Agent 统一服务
AGENT_PLATFORM_URL=http://127.0.0.1:8101
AGENT_CONNECT_TIMEOUT_SECONDS=5
AGENT_READ_TIMEOUT_SECONDS=180
# 契约 §1：与 Agent 侧 AGENT_API_TOKEN 保持一致；Agent 未配置时留空即可
AGENT_API_TOKEN=

# 业务数据库 knowledge_agent
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_agent
DB_USER=postgres
DB_PASSWORD=finance_ai_dev
# 相对项目根目录解析；也可填写绝对路径
MIGRATIONS_DIR=database

# Session 与上传文件
SESSION_TTL_SECONDS=604800
# HTTPS 生产环境必须设为 true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=session_id
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760
# 契约 §5.1：图片单张 ≤5 MB（控制 OCR 成本）
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_TTL_SECONDS=86400
EXTRACTED_TEXT_MAX_CHARS=200000
REQUEST_ATTACHMENTS_MAX_CHARS=400000

# 图片 OCR（契约 §5.1 引擎开关）：easyocr=本地识别（默认）/ none=禁用（不提取文本）
# mineru / paddle 为预留的在线/替代引擎，接入后启用
OCR_PROVIDER=easyocr
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=60
