# ═══════════════════════════════════════════════════════════════
# Finance AI KnowledgeBase — 环境变量配置模板
# 复制为 .env 后填写实际值
# ═══════════════════════════════════════════════════════════════

# ── LLM API（DeepSeek） ──
LLM_API_KEY=your_api_key_here
LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 嵌入模型 ──
EMBEDDING_MODEL=finetune-text2vec-base-chinese/merged
PRELOAD_EMBEDDING_MODEL=false
ENABLE_VECTOR_SEARCH=false
ENABLE_NEO4J=false

# ── PostgreSQL（元数据） ──
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=knowledge_base
PG_USER=postgres
PG_PASSWORD=finance_ai_dev

# ── 增量编排（hash_diff 使用） ──
PG_RAG_DBNAME=rag_service
RAGRAG_API_URL=http://127.0.0.1:8201

# ── Elasticsearch（分块+向量） ──
ES_HOST=http://localhost:9200
ES_INDEX=knowledge_chunks
ES_USER=
ES_PASSWORD=

# ── Neo4j（知识图谱） ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# ── 输入路径 ──
INPUT_FILE=
INPUT_DIR=

# ── 服务端口 ──
SEARCH_API_PORT=8002
PARSE_SERVICE_URL=http://127.0.0.1:8201
CLASSIFY_SERVICE_URL=http://127.0.0.1:8202
INGEST_MODE=direct
