# ===== DeepSeek API（当前模型方案） =====
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_TEMPERATURE=0.7    # 生成温度（沿用旧名，作用于 DeepSeek）

# ===== 远程知识库 (Finance_KnowledgeBase REST API) =====
KB_BASE_URL=http://127.0.0.1:8002
KB_TIMEOUT_SECONDS=30

# ===== Embedding 配置（agent2 本地降级检索用，当前未启用） =====
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ===== 本地降级 =====
ALLOW_LOCAL_KB_FALLBACK=false

# ===== 服务端口 =====
API_HOST=127.0.0.1
API_PORT=8101
API_RELOAD=false

# ===== 可选 API 鉴权（部署到服务器时配置；未配置则放行） =====
# AGENT_API_TOKEN=your-secret-token

# agent5 多轮记忆（PostgresSaver）连接串；不配时回退默认 postgresql://postgres:finance_ai_dev@127.0.0.1:5432/knowledge_agent
AGENT5_DB_DSN=
